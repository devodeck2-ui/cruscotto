# Autoscuola Cruscotto - configurazione locale.
# Copiare questo file in .env (stessa cartella) e adattare i valori.
# Nessun valore qui e' un segreto reale.

# --- AI Tutor --------------------------------------------------------------
# Chiave API Anthropic. Senza, l'applicazione funziona in tutto il resto e il
# tutor risponde 503 con un messaggio esplicativo.
ANTHROPIC_API_KEY=

AC_AI_MODEL=claude-sonnet-5
AC_AI_MAX_TOKENS=700
# Tetto orario di chiamate AI per autoscuola: e' insieme protezione
# anti-abuso e controllo di budget.
AC_AI_RATE=400

# --- Sicurezza -------------------------------------------------------------
# OBBLIGATORIO cambiarlo prima di esporre l'app fuori dalla rete locale:
# il valore di default e' pubblico, chiunque potrebbe forgiare token validi.
#   python3 -c "import secrets;print(secrets.token_hex(32))"
AC_JWT_SECRET=cambiami-in-produzione-32byte-min

AC_ACCESS_TTL=30
AC_REFRESH_TTL_DAYS=30

# Domini che possono chiamare l'API da browser, separati da virgola.
# In locale/demo si lascia "*". In produzione: il proprio dominio, es.
#   AC_CORS_ORIGINS=https://cruscotto.tuaautoscuola.it
AC_CORS_ORIGINS=*

# --- Percorsi e rete -------------------------------------------------------
# Di norma non serve toccarli: l'avviatore li imposta da solo.
# AC_DB=./data/autoscuola.db
# AC_MEDIA=./data/media
# AC_FRONTEND=./frontend

PORT=8080
