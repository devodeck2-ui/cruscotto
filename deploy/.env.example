# Copiare in deploy/.env prima di lanciare docker compose.

# Dominio gia' puntato all'IP di questo server (record DNS A).
DOMINIO=cruscotto.esempio.it

# Email per Let's Encrypt: riceve gli avvisi di scadenza dei certificati.
EMAIL=tecnico@esempio.it

# OBBLIGATORIO. Generare con:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
AC_JWT_SECRET=

# Facoltativa: senza, l'app funziona ma il tutor AI risponde 503.
ANTHROPIC_API_KEY=

AC_AI_MODEL=claude-sonnet-5
AC_AI_RATE=400
