# Copiare in deploy/.env prima di lanciare docker compose.

# Dominio gia' puntato all'IP di questo server (record DNS A).
DOMINIO=cruscotto.esempio.it

# Email per Let's Encrypt: riceve gli avvisi di scadenza dei certificati.
EMAIL=tecnico@esempio.it

# OBBLIGATORIO. Generare con:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
AC_JWT_SECRET=

# Facoltativa: senza, l'app funziona ma il tutor AI risponde 503.
ANTHROPIC_API_KEY=

AC_AI_MODEL=claude-sonnet-5
AC_AI_RATE=400

# Ristretto al proprio dominio: senza questo l'API accetta richieste da
# qualunque sito. Usare lo stesso valore di DOMINIO sopra, con https://.
AC_CORS_ORIGINS=https://cruscotto.esempio.it

# Notifiche push agli allievi (diretta programmata/avviata). Facoltative:
# senza, resta solo lo storico nel campanellino, senza popup sul telefono.
# Si generano una volta sola con: python3 scripts/genera_chiavi_vapid.py
AC_VAPID_PUBLIC_KEY=
AC_VAPID_PRIVATE_KEY=
AC_VAPID_SUBJECT=mailto:tecnico@esempio.it
